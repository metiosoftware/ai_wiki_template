# Set default behavior to automatically normalize all text files to LF
* text=auto eol=lf

# Explicit text file types
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf

# Binary assets (prevent Git from modifying line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
